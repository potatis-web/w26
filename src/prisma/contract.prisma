// use prisma-8

// ||=========||=========||==================================||
// ||  Field  ||  Type   ||              Params              ||
// ||=========||=========||==================================||
model Todo {
    id          String      @unique @id @default(uuid())
    text        String  
    completed   Boolean     @default(false)
}

model User {
    id          String      @unique @id @default(uuid())
    name        String 

    salt        String
    hash        String

    forums      Forum[]       
    messages    Message[]
    sessions    Session[]

    created_at  DateTime    @default(now())
}

model Forum {
    id          String      @unique @id @default(uuid())
    text        String

    messages    Message[]

    user        User        @relation(fields: [userid], references: [id])
    userid      String      

    created_at  DateTime    @default(now())

}

model Message {
    id          String      @unique @id @default(uuid())
    text        String

    forum       Forum       @relation(fields: [forumid], references: [id])
    forumid     String

    user        User        @relation(fields: [userid], references: [id])
    userid      String

    created_at  DateTime    @default(now())
    updated_at  DateTime    @default(now()) 
}

model Session {
    id          String      @unique @id @default(uuid())
    expires     DateTime

    user        User        @relation(fields: [userid], references: [id])
    userid      String
}